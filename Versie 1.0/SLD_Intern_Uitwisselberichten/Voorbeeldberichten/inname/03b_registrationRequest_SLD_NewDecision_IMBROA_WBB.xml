                    <!-- waarbij imsikb0101:SoilLocation[@gml:id = imsikb0101:Dossier/imsikb0101:soilLocation] -->
                    <!-- registered value is... 
                    <gml:MultiSurface gml:id="_cdc53818-fb86-4037-a36a-902dcc2bfda5">
                        <gml:surfaceMember>
                            <gml:Polygon gml:id="_d3acc364-51ba-4fb3-a19a-cf98bf9f944e" srsName="urn:ogc:def:crs:EPSG::28992" srsDimension="2">
                                <gml:exterior>
                                    <gml:LinearRing>
                                        <gml:posList>46889.1 372038.5 46898.8 372028.0 46909.4 372039.7 46915.5 372048.0 46906.7 372059.1 46900.0 372058.3 46890.8 372056.5 46880.8 372050.9 46885.3 372049.7 46889.1 372038.5</gml:posList>
                                    </gml:LinearRing>
                                </gml:exterior>
                            </gml:Polygon>
                        </gml:surfaceMember>
                    </gml:MultiSurface>
                    -->
                    <!-- value in feature collection from message on external interface is... 
                    <gml:MultiSurface gml:id="_cdc53818-fb86-4037-a36a-902dcc2bfda5">
                        <gml:surfaceMember>
                            <gml:Polygon gml:id="_d3acc364-51ba-4fb3-a19a-cf98bf9f944e" srsName="urn:ogc:def:crs:EPSG::28992" srsDimension="2">
                                <gml:exterior>
                                    <gml:LinearRing>
                                        <gml:posList>46889.1 372038.5 46898.8 372028.0 46909.4 372039.7 46915.5 372048.0 46906.7 372059.1 46900.0 372058.3 46890.8 372056.5 46880.8 372050.9 46885.3 372049.7 46889.1 372038.5</gml:posList>
                                    </gml:LinearRing>
                                </gml:exterior>
                            </gml:Polygon>
                        </gml:surfaceMember>
                    </gml:MultiSurface>
                    -->
                    <!-- value is the same, so boundary has to be ignored
                    <sldcom:boundary>...</sldcom:boundary>
                    -->
                    <!-- Optional: only if the follow-up changed compared to the value in the LV-BRO -->
                    <!-- vervolgactie = imsikb0101:Dossier/imsikb0101:followUpWBB; 11 = registrerenRestverontreiniging -->
                    <!-- registered value is... 
                    <sldcom:followUp codeSpace="urn:bro:sld:FollowUp">registrerenRestverontreiniging</sldcom:followUp>
                    -->
                    <!-- value in feature collection from message on external interface is: 11 = registrerenRestverontreiniging -->
                    <!-- value is the same, so followUp has to be ignored
                    <sldcom:followUp codeSpace="">?</sldcom:followUp>
                    -->
                    <!-- 0 or more repitions of relatie naar Aangepakt Gebied = imsikb0101:Dossier/imsikb0101:remediations[*] voor zover verwezen vanuit decision.
                    <sldcom:handledArea>...</sldcom:handledArea>
                     -->
                    <!-- 0 or more repitions of relatie naar Verontreinigd Gebied = imsikb0101:Dossier/imsikb0101:contaminationInfos[*] voor zover verwezen vanuit decision en zonder endTime.
                    <sldcom:contaminatedArea>...</sldcom:contaminatedArea>
                    -->
                    <!-- 0 or more repitions of relatie naar Beeindigd Verontreinigd Gebied = imsikb0101:Dossier/imsikb0101:contaminationInfos[*] voor zover verwezen vanuit decision inclusief endTime.
                    <sldcom:finishedContaminatedaArea>...</sldcom:finishedContaminatedaArea>
                    -->
                    <!-- 0 or more repitions of relatie naar Nazorggebied = imsikb0101:Dossier/imsikb0101:sitemanagements[*] voor zover verwezen vanuit decision en zonder endTime. -->
                    <!-- SitemanagementMeasure gml:id="_d7b1c2d6-476d-4289-9792-3bedf303d108" heeft geen endTime -->
                    <!-- TODO aftercareArea -->
                    <sldcom:aftercareArea>
                        <sldcom:AftercareAreaNewDecision gml:id="id0003">
                            <!-- SIKB0101-identificatie = imsikb0101:SitemanagementMeasure/imsikb0101:identification/immetingen:NEN3610ID/immetingen:lokaalID -->
                            <sldcom:identification>d7b1c2d6-476d-4289-9792-3bedf303d108</sldcom:identification>
