                                    <sldcom:identification>a19e793b-18f8-4901-ac88-c6eba940d9d9</sldcom:identification>
                                    <!-- gebruiksbeperking = imsikb0101:UsageRestriction/imsikb0101:restriction; 13 = onderzoekenDrinkwaterkwaliteit -->
                                    <sldcom:usageRestriction codeSpace="urn:bro:sld:UsageRestriction">onderzoekenDrinkwaterkwaliteit</sldcom:usageRestriction>
                                </sldcom:AftercareMeasure>
                            </sldcom:aftercareMeasure>
                        </sldcom:AftercareAreaNewDecision>
                    </sldcom:aftercareArea>
                    <!-- 0 or more repitions of relatie naar Beeindigd Nazorggebied = imsikb0101:Dossier/imsikb0101:sitemanagements[*] voor zover verwezen vanuit decision inclusief endTime. -->
