                                            <gml:exterior>
                                                <gml:LinearRing>
                                                    <gml:posList>46843.61 371998.56 46833.52 372014.91 46822.56 372007.85 46822.68 372007.79 46822.62 372007.3 46833.77 371991.56 46843.61 371998.56</gml:posList>
                                                </gml:LinearRing>
                                            </gml:exterior>
                                        </gml:Polygon>
                                    </gml:surfaceMember>
                                    <gml:surfaceMember>
                                        <gml:Polygon gml:id="_dfe5c250-9fc6-447f-9a05-846558e71883" srsName="urn:ogc:def:crs:EPSG::28992" srsDimension="2">
                                            <gml:exterior>
                                                <gml:LinearRing>
                                                    <gml:posList>46824.54 372016.34 46819.21 372022.72 46805.84 372013.61 46809.86 372007.48 46824.54 372016.34</gml:posList>
                                                </gml:LinearRing>
                                            </gml:exterior>
                                        </gml:Polygon>
                                    </gml:surfaceMember>
                                    <gml:surfaceMember>
                                        <gml:Polygon gml:id="_58b5e810-4bc6-4c0c-88c3-5d36cbd2a5ea" srsName="urn:ogc:def:crs:EPSG::28992" srsDimension="2">
                                            <gml:exterior>
                                                <gml:LinearRing>
                                                    <gml:posList>46833.15 372023.15 46831.17 372024.7 46828.19 372021.42 46828.87 372020.73 46829.25 372019.25 46830.48 372019.99 46833.02 372021.42 46833.15 372023.15</gml:posList>
                                                </gml:LinearRing>
                                            </gml:exterior>
                                        </gml:Polygon>
                                    </gml:surfaceMember>
                                </gml:MultiSurface>
                            </sldcom:boundary>
                            <!-- optioneel: begindiepte = imsikb0101:SitemanagementMeasure/imsikb0101:upperDepth/immetingen:Depth/immetingen:value -->
                            <!-- Waarbij immetingen:Depth/immetingen:condition moet zijn: t.o.v. maaiveld (ID: 11)
                            <sldcom:beginDepth uom="">...</sldcom:beginDepth>
                            -->
                            <!-- optioneel: maximale einddiepte = imsikb0101:SitemanagementMeasure/imsikb0101:lowerDepth/immetingen:Depth/immetingen:value -->
                            <!-- Waarbij immetingen:Depth/immetingen:condition moet zijn: t.o.v. maaiveld (ID: 11)
                            <sldcom:maximumEndDepth uom=""></sldcom:maximumEndDepth>
                            -->
                            <!-- optioneel: nazorg oneindig = imsikb0101:SitemanagementMeasure/imsikb0101:duration == -1
                            <sldcom:aftercareInfinite>?</sldcom:aftercareInfinite>
                            -->
                            <!-- optioneel: duur nazorg = imsikb0101:SitemanagementMeasure/imsikb0101:duration. -->
                            <sldcom:durationAftercare>10</sldcom:durationAftercare>
                            <!-- datum inwerking = imsikb0101:SitemanagementMeasure/imsikb0101:startTime -->
                            <sldcom:effectiveDate>2024-10-15</sldcom:effectiveDate>
                            <!-- is vermeld in (relatie naar Besluit) = imsikb0101:Dossier/imsikb0101:decisions[0]/imsikb0101:Decision/imsikb0101:identification/immetingen:NEN3610ID/immetingen:lokaalID -->
                            <sldcom:referencedByDecision>426f7ea5-c871-478b-a702-4d3120a5ba0b</sldcom:referencedByDecision>
                            <!-- 0 or more repetitions: is opgelegd (relaties naar Nazorgmaatregel) = imsikb0101:SitemanagementMeasure/imsikb0101:usageRestrictions[] -->
                            <sldcom:aftercareMeasure>
                                <sldcom:AftercareMeasure gml:id="id0004">
