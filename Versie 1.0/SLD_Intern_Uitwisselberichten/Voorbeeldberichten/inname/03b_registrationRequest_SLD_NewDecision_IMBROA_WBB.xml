                            <sldcom:identification>426f7ea5-c871-478b-a702-4d3120a5ba0b</sldcom:identification>
                            <!-- besluitkenmerk = imsikb0101:Decision/imsikb0101:characteristic -->
                            <sldcom:decisionReference>RMW0210330</sldcom:decisionReference>
                            <!-- besluittype = imsikb0101:Decision/imsikb0101:decisionType; 28 = vaststellingVerontreinigingErnstigUrgentSanerenBinnen4jaar -->
                            <sldcom:decisionType codeSpace="urn:bro:sld:DecisionType">vaststellingVerontreinigingErnstigUrgentSanerenBinnen4jaar</sldcom:decisionType>
                            <!-- datum besluit = imsikb0101:Decision/imsikb0101:startTime -->
                            <sldcom:decisionDate>2024-10-15</sldcom:decisionDate>
                        </sldcom:DecisionNewDecision>
                    </sldcom:decision>
                </sldcom:SoilLocationNewDecision>
            </sldcom:soilLocation>
        </sldcom:SLD_NewDecision>
    </sourceDocument>
</registrationRequest>
