   <xs:element name="parseFault"
               type="brocom:ParseFaultType" />
   <xs:element name="dispatchCharacteristicsRequest"
               type="dssldinternal:DispatchCharacteristicsRequestType">
      <xs:annotation>
         <xs:documentation source="http://www.imvertor.org/model-info/technical-documentation">Definition: Het DispatchCharacteristicsRequest is een specialisatie van de abstract klasse AbstractDispatchCharacteristicsRequest in de package brocommon, waaraan het een element SLD_Criteriaset toevoegt.</xs:documentation>
      </xs:annotation>
   </xs:element>
   <xs:complexType name="DispatchCharacteristicsRequestType">
      <xs:complexContent>
         <xs:extension base="brocom:AbstractDispatchCharacteristicsRequestType">
            <xs:sequence>
               <xs:element minOccurs="1"
                           maxOccurs="1"
                           name="criteria"
                           nillable="false"
                           type="dssldinternal:SLD_CriteriaSetType">
                  <xs:annotation>
                     <xs:documentation source="http://www.imvertor.org/model-info/technical-documentation">Definition: Het geheel van kenmerken waaraan een Overheidsbesluiten bodemverontreiniging dat de gebruiker opvraagt moet voldoen.</xs:documentation>
                  </xs:annotation>
               </xs:element>
            </xs:sequence>
         </xs:extension>
      </xs:complexContent>
   </xs:complexType>
   <xs:element name="dispatchCharacteristicsResponse"
               type="dssldinternal:DispatchCharacteristicsResponseType">
      <xs:annotation>
         <xs:documentation source="http://www.imvertor.org/model-info/technical-documentation">Definition: Het bericht DispatchCharacteristicsResponse is een specialisatie van DispatchResponse in de package brocommon, waaraan het een attribuut numberOfDocuments en een associatie relatie naar AbstractRegistrationObject in de package brocommon toevoegt.</xs:documentation>
      </xs:annotation>
   </xs:element>
   <xs:complexType name="DispatchCharacteristicsResponseType">
      <xs:complexContent>
         <xs:extension base="brocom:DispatchResponseType">
            <xs:sequence>
               <xs:element name="numberOfDocuments"
                           type="xs:integer"
                           minOccurs="1"
                           maxOccurs="1">
                  <xs:annotation>
                     <xs:documentation source="http://www.imvertor.org/model-info/technical-documentation">Definition: Het aantal registratieobjecten dat voldoet aan de criteria (kenmerken) in het verzoek tot uitgifte van kengegevens.</xs:documentation>
                  </xs:annotation>
               </xs:element>
               <xs:element minOccurs="0"
                           maxOccurs="unbounded"
                           name="dispatchDocument"
                           nillable="false"
                           type="brocom:AbstractRegistrationObjectPropertyType"/>
            </xs:sequence>
         </xs:extension>
      </xs:complexContent>
   </xs:complexType>
   <xs:element name="dispatchDataRequest"
               type="dssldinternal:DispatchDataRequestType">
      <xs:annotation>
         <xs:documentation source="http://www.imvertor.org/model-info/technical-documentation">Definition: Het DispatchDataRequest is een specialisatie van de abstract klasse DispatchDataRequest in de package brocommon, waaraan het een element dataToBeDelivered toevoegt.</xs:documentation>
      </xs:annotation>
   </xs:element>
   <xs:complexType name="DispatchDataRequestType">
      <xs:complexContent>
         <xs:extension base="brocom:DispatchDataRequestType">
            <xs:sequence>
               <xs:element name="dataToBeDelivered"
                           type="dssldinternal:DataToBeDeliveredType"
                           minOccurs="1"
                           maxOccurs="1">
                  <xs:annotation>
                     <xs:documentation source="http://www.imvertor.org/model-info/technical-documentation">Definition: Aanduiding welke gegevens over het registratieobject worden opgevraagd: alleen de actuele gegevens (present object data) of de actuele gegevens en de volledige materiële geschiedenis (past and present object data).</xs:documentation>
                  </xs:annotation>
               </xs:element>
            </xs:sequence>
         </xs:extension>
      </xs:complexContent>
   </xs:complexType>
   <xs:element name="dispatchDataResponse"
               type="dssldinternal:DispatchDataResponseType">
      <xs:annotation>
         <xs:documentation source="http://www.imvertor.org/model-info/technical-documentation">Definition: Het bericht DispatchDataResponse is een specialisatie van de abstract klasse DispatchResponse uit de package brocommon, waaraan het een dispatchDocument toevoegt. Met dit bericht worden, als response op een DispatchDataRequest, de gegevens over een specifiek bodemonderzoek registratieobject verzonden naar de aanvrager.</xs:documentation>
      </xs:annotation>
   </xs:element>
   <xs:complexType name="DispatchDataResponseType">
      <xs:complexContent>
          <xs:extension base="brocom:DispatchResponseType">
              <xs:sequence>
                  <xs:element minOccurs="0" maxOccurs="1" name="dispatchDocument" nillable="false" type="brocom:AbstractRegistrationObjectPropertyType">
                      <xs:annotation>
                          <xs:documentation source="http://www.imvertor.org/model-info/technical-documentation">Definition: Het element dispatchDocument bevat de gegevens van een bodemonderzoek registratieobject. Vanwege het polymorfe karakter is het type óf een BRODO uit de package brocom, óf een SLDODP, óf een SLDO uit de package dssad. Deze drie types hebben allen als gemeenschappelijke vader het type AbstractRegistrationObject uit de package brocom.
Explanation: Het gegeven ontbreekt als de BRO geen registratieobject bevat met het in het dispatchDataRequest opgegegeven broId. Het gegeven is aanwezig en van het type BROD_DO als het registratieobject met de opgegeven broId uit registratie is genomen. Het gegeven is aanwezig en van het type SLDODP als het registratieobject met de opgegeven broId niet uit registratie is genomen en de afnemer tevens bronhouder en/of dataleverancier is van het registratieobject. Het gegeven is aanwezig en van het type SLD_O als het registratieobject met de opgegeven broId niet uit registratie is genomen en de afnemer niet bronhouder of dataleverancier is van het registratieobject.</xs:documentation>
                      </xs:annotation>
                  </xs:element>
              </xs:sequence>
          </xs:extension>
      </xs:complexContent>
  </xs:complexType>
   <xs:element name="SLD_C"
               type="dssldinternal:SLD_CType"
               substitutionGroup="brocom:AbstractCharacteristicsV2">
      <xs:annotation>
         <xs:documentation source="http://www.imvertor.org/model-info/technical-documentation">Definition: Het uitgiftedocument dat de kengegevens bevat van overheidsbesluiten bodemverontreiniging die voldoen aan opgegeven zoekcriteria.</xs:documentation>
      </xs:annotation>
   </xs:element>
   <xs:complexType name="SLD_CType">
      <xs:complexContent>
         <xs:extension base="brocom:AbstractCharacteristicsV2Type">
            <xs:sequence>
               <xs:element name="deliveryContext"
                           minOccurs="1"
                           maxOccurs="1"
                           type="sldcominternal:DeliveryContextType">
                  <xs:annotation>
                     <xs:appinfo>
                        <CodeListName>DeliveryContext</CodeListName>
                        <CodeListURI>urn:bro:sld:DeliveryContext</CodeListURI>
                     </xs:appinfo>
                  </xs:annotation>
               </xs:element>
               <xs:element name="soilLocationOrHandledArea"
                           type="dssldinternal:SoilLocationOrHandledArea_CPropertyType"
                           minOccurs="1"
                           maxOccurs="1"/>
            </xs:sequence>
         </xs:extension>
      </xs:complexContent>
   </xs:complexType>
   <xs:complexType name="SLD_CPropertyType">
      <xs:sequence minOccurs="1">
         <xs:element ref="dssldinternal:SLD_C"/>
      </xs:sequence>
   </xs:complexType>
   <xs:element name="AftercareArea_C"
               type="dssldinternal:AftercareArea_CType"
               substitutionGroup="gml:AbstractFeature"/>
   <xs:complexType name="AftercareArea_CType">
      <xs:complexContent>
         <xs:extension base="gml:AbstractFeatureType">
            <xs:sequence>
               <xs:element name="aftercareInfinite"
                           type="brocom:IndicationYesNoType"
                           minOccurs="0"
                           maxOccurs="1"/>
               <xs:element name="boundary"
                           type="gml:MultiSurfacePropertyType"
                           minOccurs="1"
                           maxOccurs="1"/>
               <xs:element name="durationAftercare"
                           type="xs:integer"
                           minOccurs="0"
                           maxOccurs="1"/>
               <xs:element name="endDate" type="xs:date" minOccurs="1" maxOccurs="1"/>
            </xs:sequence>
         </xs:extension>
      </xs:complexContent>
   </xs:complexType>
   <xs:complexType name="AftercareArea_CPropertyType">
      <xs:sequence minOccurs="0">
         <xs:element ref="dssldinternal:AftercareArea_C"/>
      </xs:sequence>
      <xs:attributeGroup ref="gml:AssociationAttributeGroup"/>
   </xs:complexType>
   <xs:element name="SLD_PO_DP"
               type="dssldinternal:SLD_PO_DPType"
               substitutionGroup="brocom:RegistrationObject">
      <xs:annotation>
         <xs:documentation source="http://www.imvertor.org/model-info/technical-documentation">Definition: Het uitgiftedocument dat actuele gegevens bevat van een overheidsbesluit bodemverontreiniging, die beschikbaar zijn voor de dataleverancier en/of bronhouder, ongeacht of een registratieobject uit registratie is genomen of niet.
Explanation: Voor de attributen met materiële geschiedenis wordt de actuele waarde getoond (boundary (begrenzing) en followUpWbb (vervolgactie Wbb), beide attributen van de entiteit SoilLocation (Bodemlocatie)). Het attribuut sourceDocument (brondocument) binnen de gegevensgroep Event (Gebeurtenis) is niet aanwezig.</xs:documentation>
      </xs:annotation>
   </xs:element>
   <xs:complexType name="SLD_PO_DPType">
      <xs:complexContent>
         <xs:extension base="brocom:RegistrationObjectType">
            <xs:sequence>
               <xs:element name="deliveryContext"
                           minOccurs="1"
                           maxOccurs="1"
                           type="sldcominternal:DeliveryContextType">
                  <xs:annotation>
                     <xs:appinfo>
                        <CodeListName>DeliveryContext</CodeListName>
                        <CodeListURI>urn:bro:sld:DeliveryContext</CodeListURI>
                     </xs:appinfo>
                  </xs:annotation>
               </xs:element>
               <xs:element minOccurs="1"
                           maxOccurs="1"
                           name="registrationHistory"
                           nillable="false"
                           type="brocom:RegistrationHistoryType"/>
               <xs:element minOccurs="1"
                           maxOccurs="1"
                           name="standardizedLocation"
                           nillable="false"
                           type="brocom:StandardizedLocationV2Type"/>
               <xs:element name="soilLocationOrHandledArea"
                           type="dssldinternal:SoilLocationOrHandledAreaPropertyType"
                           minOccurs="1"
                           maxOccurs="1"/>
            </xs:sequence>
         </xs:extension>
      </xs:complexContent>
   </xs:complexType>
   <xs:complexType name="SLD_PO_DPPropertyType">
      <xs:sequence minOccurs="1">
         <xs:element ref="dssldinternal:SLD_PO_DP"/>
      </xs:sequence>
   </xs:complexType>
   <xs:element name="SLD_PO"
               type="dssldinternal:SLD_POType"
               substitutionGroup="dssldinternal:SLD_PO_DP">
      <xs:annotation>
         <xs:documentation source="http://www.imvertor.org/model-info/technical-documentation">Definition: Het uitgiftedocument dat de actuele gegevens bevat van een overheidsbesluit bodemverontreiniging (die niet uit registratie is genomen), die beschikbaar zijn voor een standaard afnemer.
Explanation: Voor de attributen met materiële geschiedenis wordt de actuele waarde getoond (boundary (begrenzing) en followUpWbb (vervolgactie Wbb), beide attributen van de entiteit SoilLocation (Bodemlocatie)). Het attribuut sourceDocument (brondocument) binnen de gegevensgroep Event (Gebeurtenis) is niet aanwezig.</xs:documentation>
      </xs:annotation>
   </xs:element>
   <xs:complexType name="SLD_POType">
      <xs:complexContent>
         <xs:extension base="dssldinternal:SLD_PO_DPType"/>
      </xs:complexContent>
   </xs:complexType>
   <xs:complexType name="SLD_POPropertyType">
      <xs:sequence minOccurs="1">
         <xs:element ref="dssldinternal:SLD_PO"/>
      </xs:sequence>
   </xs:complexType>
   <xs:element name="ContaminatedArea_C"
               type="dssldinternal:ContaminatedArea_CType"
               substitutionGroup="gml:AbstractFeature"/>
   <xs:complexType name="ContaminatedArea_CType">
      <xs:complexContent>
         <xs:extension base="gml:AbstractFeatureType">
            <xs:sequence>
               <xs:element name="boundary"
                           type="gml:MultiSurfacePropertyType"
                           minOccurs="0"
                           maxOccurs="1"/>
               <xs:element name="compartment"
                           minOccurs="1"
                           maxOccurs="1"
                           type="sldcominternal:CompartmentType">
                  <xs:annotation>
                     <xs:appinfo>
                        <CodeListName>Compartment</CodeListName>
                        <CodeListURI>urn:bro:sld:Compartment</CodeListURI>
                     </xs:appinfo>
                  </xs:annotation>
               </xs:element>
               <xs:element name="endDate" type="xs:date" minOccurs="1" maxOccurs="1"/>
            </xs:sequence>
         </xs:extension>
      </xs:complexContent>
   </xs:complexType>
   <xs:complexType name="ContaminatedArea_CPropertyType">
      <xs:sequence minOccurs="0">
         <xs:element ref="dssldinternal:ContaminatedArea_C"/>
      </xs:sequence>
      <xs:attributeGroup ref="gml:AssociationAttributeGroup"/>
   </xs:complexType>
   <xs:element name="SLD_PPO_DP"
               type="dssldinternal:SLD_PPO_DPType"
               substitutionGroup="dssldinternal:SLD_PO_DP">
      <xs:annotation>
         <xs:documentation source="http://www.imvertor.org/model-info/technical-documentation">Definition: Het uitgiftedocument dat chronologisch geordend de gegevens bevat van een overheidsbesluiten bodemverontreiniging, die beschikbaar zijn voor de dataleverancier en/of bronhouder, ongeacht of het registratieobject uit registratie is genomen of niet.
Explanation: Het registratieobject bevat niet de actuele gegevens, maar de gegevens zoals aangeleverd in het brondocument waarmee de registratie werd gestart, aangevuld met de gegevens die op dat moment zijn afgeleid door de basisregistratie ondergrond. Voor iedere gegevensgroep Event (Gebeurtenis) van de gegevensgroep locationHistory (Locatiegeschiedenis) van de SoilLocation (Bodemlocatie) is het attribuut sourceDcoument (brondocument) aanwezig, met daarin het desbetreffende aangeleverde brondocument.</xs:documentation>
      </xs:annotation>
   </xs:element>
   <xs:complexType name="SLD_PPO_DPType">
      <xs:complexContent>
         <xs:extension base="dssldinternal:SLD_PO_DPType"/>
      </xs:complexContent>
   </xs:complexType>
   <xs:complexType name="SLD_PPO_DPPropertyType">
      <xs:sequence minOccurs="1">
         <xs:element ref="dssldinternal:SLD_PPO_DP"/>
      </xs:sequence>
   </xs:complexType>
   <xs:element name="SLD_PPO"
               type="dssldinternal:SLD_PPOType"
               substitutionGroup="dssldinternal:SLD_PPO_DP">
      <xs:annotation>
         <xs:documentation source="http://www.imvertor.org/model-info/technical-documentation">Definition: Het uitgiftedocument dat chronologisch geordend de gegevens bevat van een overheidsbesluiten bodemverontreiniging (die niet uit registratie is genomen), die beschikbaar zijn voor een standaard afnemer.
Explanation: Het registratieobject bevat niet de actuele gegevens, maar de gegevens zoals aangeleverd in het brondocument waarmee de registratie werd gestart, aangevuld met de gegevens die op dat moment zijn afgeleid door de basisregistratie ondergrond. Voor iedere gegevensgroep Event (Gebeurtenis) van de gegevensgroep locationHistory (Locatiegeschiedenis) van de SoilLocation (Bodemlocatie) is het attribuut sourceDcoument (brondocument) aanwezig, met daarin het desbetreffende aangeleverde brondocument.</xs:documentation>
      </xs:annotation>
   </xs:element>
   <xs:complexType name="SLD_PPOType">
      <xs:complexContent>
         <xs:extension base="dssldinternal:SLD_PPO_DPType"/>
      </xs:complexContent>
   </xs:complexType>
   <xs:complexType name="SLD_PPOPropertyType">
      <xs:sequence minOccurs="1">
         <xs:element ref="dssldinternal:SLD_PPO"/>
      </xs:sequence>
   </xs:complexType>
   <xs:element name="HandledArea_C"
               type="dssldinternal:HandledArea_CType"
               substitutionGroup="gml:AbstractFeature">
      <xs:annotation>
         <xs:documentation source="http://www.imvertor.org/model-info/technical-documentation">Definition: Een geografisch begrensd oppervlak waarbinnen een sanering is uitgevoerd of waarbinnen grond is ontgraven en afgevoerd zonder saneringsdoelstelling.
Explanation: Het betreft een gebied waar 1) is gesaneerd of zonder saneringsdoelstelling is gegraven in bodem met een kwaliteit boven interventiewaarde (&gt;I) waarbij bovendien de uitgegraven grond is afgevoerd (dit zijn milieubelastende activiteiten onder het regime van de Omgevingswet), of waar 2) een sanering is uitgevoerd onder het regime van de Wet bodembescherming. Het bevoegd gezag heeft, nadat in het gebied is gesaneerd of is ontgraven zonder saneringsdoelstelling, een evaluatieverslag ontvangen en geaccepteerd. De betreffende werkzaamheden worden veelal uitgevoerd onder toezicht van bedrijven die gecertificeerd zijn volgens BRL SIKB 6000, protocol 6001 of 6005. Onder de Wet bodembescherming neemt het bevoegd gezag op basis van het evaluatieverslag een instemmingsbesluit en legt deze vast in een beschikking (conform Wbb art. 39c lid 2). Onder de Omgevingswet is een dergelijk besluit niet aan de orde. In de basisregistratie ondergrond worden geen gebieden vastgelegd van saneringen die zijn gepland maar nog niet zijn uitgevoerd. Voor gegevens die onder IMBRO/A zijn aangeleverd is het echter niet uitgesloten dat ook gebieden zijn opgenomen waar wel een sanering is gepland maar nog niet is uitgevoerd.</xs:documentation>
      </xs:annotation>
   </xs:element>
   <xs:complexType name="HandledArea_CType">
      <xs:complexContent>
         <xs:extension base="gml:AbstractFeatureType">
            <xs:sequence>
               <xs:element name="activityEndDate"
                           type="xs:date"
                           minOccurs="1"
                           maxOccurs="1"/>
               <xs:element name="approach"
                           minOccurs="0"
                           maxOccurs="1"
                           type="sldcominternal:ApproachType">
                  <xs:annotation>
                     <xs:appinfo>
                        <CodeListName>Approach</CodeListName>
                        <CodeListURI>urn:bro:sld:Approach</CodeListURI>
                     </xs:appinfo>
                     <xs:documentation source="http://www.imvertor.org/model-info/technical-documentation">Definition: De aanpak die moet zijn gevolgd bij het saneren of ontgraven binnen het aangepakt gebied.</xs:documentation>
                  </xs:annotation>
               </xs:element>
               <xs:element name="boundary"
                           type="gml:MultiSurfacePropertyType"
                           minOccurs="0"
                           maxOccurs="1"/>
               <xs:element name="compartment"
                           minOccurs="1"
                           maxOccurs="1"
                           type="sldcominternal:CompartmentType">
                  <xs:annotation>
                     <xs:appinfo>
                        <CodeListName>Compartment</CodeListName>
                        <CodeListURI>urn:bro:sld:Compartment</CodeListURI>
                     </xs:appinfo>
                  </xs:annotation>
               </xs:element>
               <xs:element name="identification"
                           type="xs:string"
                           minOccurs="1"
                           maxOccurs="1"/>
            </xs:sequence>
         </xs:extension>
      </xs:complexContent>
   </xs:complexType>
   <xs:complexType name="HandledArea_CPropertyType">
      <xs:sequence minOccurs="0">
         <xs:element ref="dssldinternal:HandledArea_C"/>
      </xs:sequence>
      <xs:attributeGroup ref="gml:AssociationAttributeGroup"/>
   </xs:complexType>
   <xs:element name="Decision_C"
               type="dssldinternal:Decision_CType"
               substitutionGroup="gml:AbstractFeature"/>
   <xs:complexType name="Decision_CType">
      <xs:complexContent>
         <xs:extension base="gml:AbstractFeatureType">
            <xs:sequence>
               <xs:element name="decisionDate" type="xs:date" minOccurs="1" maxOccurs="1"/>
               <xs:element name="decisionReference"
                           minOccurs="1"
                           maxOccurs="1"
                           type="xs:string"/>
               <xs:element name="decisionType"
                           minOccurs="1"
                           maxOccurs="1"
                           type="sldcominternal:DecisionTypeType">
                  <xs:annotation>
                     <xs:appinfo>
                        <CodeListName>DecisionType</CodeListName>
                        <CodeListURI>urn:bro:sld:DecisionType</CodeListURI>
                     </xs:appinfo>
                  </xs:annotation>
               </xs:element>
            </xs:sequence>
         </xs:extension>
      </xs:complexContent>
   </xs:complexType>
   <xs:complexType name="Decision_CPropertyType">
      <xs:sequence minOccurs="0">
         <xs:element ref="dssldinternal:Decision_C"/>
      </xs:sequence>
      <xs:attributeGroup ref="gml:AssociationAttributeGroup"/>
   </xs:complexType>
   <xs:element name="SoilLocation"
               type="dssldinternal:SoilLocationType"
               substitutionGroup="gml:AbstractFeature">
      <xs:annotation>
         <xs:documentation source="http://www.imvertor.org/model-info/technical-documentation">Definition: De eenheid of verzameling van eenheden met een vermoeden of bewezen bodemverontreiniging die als één geheel wordt aangepakt onder het regime van de Wet bodembescherming.
Explanation: De grens van een bodemlocatie valt niet per se samen met de grens van één geval van bodemverontreiniging. Een locatie kan meerdere gevallen bevatten. Het kan ook voorkomen dat een bodemlocatie is aangemaakt door een niet-bevoegd gezag Wet bodembescherming op basis van een uitgevoerd milieuhygiënisch bodemonderzoek. Bodemlocaties kunnen elkaar overlappen.</xs:documentation>
      </xs:annotation>
   </xs:element>
   <xs:complexType name="SoilLocationType">
      <xs:complexContent>
         <xs:extension base="gml:AbstractFeatureType">
            <xs:sequence>
               <xs:element name="boundary"
                           type="gml:MultiSurfacePropertyType"
                           minOccurs="1"
                           maxOccurs="1"/>
               <xs:element name="dossierIdLocalAuthority"
                           minOccurs="1"
                           maxOccurs="1"
                           type="xs:string"/>
               <xs:element name="dossierIdSoilInformationSystem"
                           minOccurs="1"
                           maxOccurs="1"
                           type="xs:string"/>
               <xs:element name="followUp"
                           minOccurs="0"
                           maxOccurs="1"
                           type="sldcominternal:FollowUpType">
                  <xs:annotation>
                     <xs:appinfo>
                        <CodeListName>FollowUp</CodeListName>
                        <CodeListURI>urn:bro:sld:FollowUp</CodeListURI>
                     </xs:appinfo>
                  </xs:annotation>
               </xs:element>
               <xs:element name="identification"
                           type="xs:string"
                           minOccurs="1"
                           maxOccurs="1"/>
               <xs:element minOccurs="0"
                           maxOccurs="1"
                           name="locationHistory"
                           nillable="false"
                           type="dssldinternal:LocationHistoryType"/>
               <xs:element name="name" minOccurs="0" maxOccurs="1" type="xs:string"/>
               <xs:element minOccurs="0"
                           maxOccurs="unbounded"
                           name="decision"
                           nillable="false"
