                            <xs:restriction base="xs:string">
                                <xs:maxLength value="40"/>
                            </xs:restriction>
                        </xs:simpleType>
                    </xs:element>
                    <xs:element name="boundary" type="gml:MultiSurfacePropertyType" minOccurs="1" maxOccurs="1">
                        <xs:annotation>
                            <xs:documentation source="http://www.imvertor.org/model-info/technical-documentation">Definition: De grens van het gebied van de vastgestelde verontreiniging.
Explanation: De contour van de verontreiniging is met behulp van het toetsingskader, op basis van de gemeten concentraties uit het bodemonderzoek bepaald.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element name="compartment" minOccurs="1" maxOccurs="1" type="sldcom:CompartmentType">
                        <xs:annotation>
                            <xs:appinfo>
                                <CodeListName>Compartment</CodeListName>
                                <CodeListURI>urn:bro:sld:Compartment</CodeListURI>
                            </xs:appinfo>
                            <xs:documentation source="http://www.imvertor.org/model-info/technical-documentation">Definition: De aanduiding van het compartiment waarop de verontreiniging betrekking heeft.
Explanation: Dat is grond of grondwater. Waterbodem is buiten scope van BRO Milieukwaliteit.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element name="exceededClass" minOccurs="0" maxOccurs="1" type="sldcom:ExceededClassType">
                        <xs:annotation>
                            <xs:appinfo>
                                <CodeListName>ExceededClass</CodeListName>
                                <CodeListURI>urn:bro:sld:ExceededClass</CodeListURI>
                            </xs:appinfo>
                            <xs:documentation source="http://www.imvertor.org/model-info/technical-documentation">Definition: De grenswaarde, geldig onder het regime van de Wet bodembescherming, die binnen de contour van het verontreinigd gebied wordt overschreden.
Explanation: De toetsingswaarde in het kader van de Wbb is de interventiewaarde (I-waarde). In sommige gevallen is een verontreinigd gebied op basis van de streefwaarde (S-waarde) of van de achtergrondwaarde (AW-waarde) geregistreerd. De overschreden toetsingswaarde is niet altijd in het bronsysteem ingevuld.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element name="beginDepth" minOccurs="0" maxOccurs="1">
                        <xs:annotation>
                            <xs:documentation source="http://www.imvertor.org/model-info/technical-documentation">Definition: De diepte waarop de vastgestelde verontreiniging begint.
Explanation: De diepte is vastgelegd ten opzichte van het maaiveld. De begindiepte is niet altijd in het bronsysteem ingevuld.</xs:documentation>
                        </xs:annotation>
                        <xs:complexType>
                            <xs:simpleContent>
                                <xs:restriction base="gml:MeasureType">
                                    <xs:attribute name="uom" type="gml:UomIdentifier" use="required" fixed="m"/>
                                </xs:restriction>
                            </xs:simpleContent>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="maximumEndDepth" minOccurs="0" maxOccurs="1">
                        <xs:annotation>
                            <xs:documentation source="http://www.imvertor.org/model-info/technical-documentation">Definition: De maximale diepte waarop de vastgestelde verontreiniging eindigt.
Explanation: De diepte is vastgelegd ten opzichte van het maaiveld. De maximale einddiepte is niet altijd in het bronsysteem ingevuld.</xs:documentation>
                        </xs:annotation>
                        <xs:complexType>
                            <xs:simpleContent>
                                <xs:restriction base="gml:MeasureType">
                                    <xs:attribute name="uom" type="gml:UomIdentifier" use="required" fixed="m"/>
                                </xs:restriction>
                            </xs:simpleContent>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="dateDecreed" type="xs:date" minOccurs="0" maxOccurs="1">
                        <xs:annotation>
                            <xs:documentation source="http://www.imvertor.org/model-info/technical-documentation">Definition: De datum waarop de verontreiniging is vastgesteld.
Explanation: Deze datum is de datum inwerkingtreding van het onderliggende besluit dat het bevoegd gezag Wbb heeft genomen. De datum vastgesteld is niet altijd in het bronsysteem ingevuld.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element name="endDate" type="xs:date" minOccurs="0" maxOccurs="1">
                        <xs:annotation>
                            <xs:documentation source="http://www.imvertor.org/model-info/technical-documentation">Definition: De datum waarop het verontreinigd gebied niet langer geldig is.
Explanation: De einddatum wordt vastgelegd wanneer het verontreinigd gebied is beëindigd. Het verontreinigd gebied wordt beëindigd wanneer de verontreiniging volledig is verwijderd en het bevoegd gezag heeft ingestemd met het evaluatieverslag van de (uniforme) sanering. Ook wanneer na de sanering een restverontreiniging is overgebleven, wordt het verontreinigd gebied beëindigd; voor de restverontreiniging wordt er een nieuw verontreinigd gebied geregistreerd in de basisregistratie ondergrond. Van bodemlocaties die vóór 1 januari 2024 zijn afgerond onder het regime van de Wbb, zijn de gegevens aangeleverd aan de basisregistratie ondergrond in het kader van archiefoverdracht. Bij deze gegevens is de einddatum niet altijd vastgelegd omdat het in het bronsysteem niet altijd is ingevuld. Van bodemlocaties die vanaf 1 januari 2024 onder het overgangsrecht vallen, zijn de gegevens die zijn ontstaan onder het regime van de Wbb (tot 1 januari 2024) aangeleverd aan de basisregistratie ondergrond in het kader van archiefoverdracht. Bij deze gegevens is de einddatum niet altijd in het bronsysteem ingevuld. Uit het ontbreken van de einddatum kan niet worden afgeleid dat de verontreiniging nog aanwezig is. Bij aangeleverde nieuwe gegevens die zijn ontstaan op basis van besluiten die zijn genomen onder het overgangsrecht is de einddatum, indien van toepassing, altijd vastgelegd.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element minOccurs="0" maxOccurs="1" name="contaminationNature" nillable="false" type="sldcom:ContaminationNatureType">
                        <xs:annotation>
                            <xs:documentation source="http://www.imvertor.org/model-info/technical-documentation">Definition: De karakterisering van de verontreiniging.
Explanation: De aard van de verontreiniging komt tot uiting in een lijst met de chemische stoffen die de verontreiniging kenmerken. De aard verontreiniging is niet altijd in het bronsysteem ingevuld.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element minOccurs="0" maxOccurs="1" name="referencedByDecisions" nillable="false" type="sldcom:ReferencedByDecisionsType">
                        <xs:annotation>
                            <xs:documentation source="http://www.imvertor.org/model-info/technical-documentation">Definition: Optionele lijst van besluiten, ieder geïdentificeerd door hun SIKB0101-identificatie, waarin het gebied is vermeld.</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>
