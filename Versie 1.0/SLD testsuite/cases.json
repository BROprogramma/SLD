{
  "_uitleg": "Gedeelde handgeschreven testcases voor alle SLD-versies. Elke case neemt een goed bericht (source of sources), past het in het geheugen aan (mutations) en controleert dat de XSLT die bij dat bericht hoort de verwachte NIEUWE melding geeft. Versie-afhankelijke waarden: ${NAAM} uit versies/<versie>/versie.json. Zie README.md.",
  "cases": [
    {
      "name": "Metadata - dataflow ontbreekt",
      "sources": [
        "01_registrationRequest_SLD_CompleteReport_IMBRO_OW.xml",
        "02_registrationRequest_SLD_CompleteReport_IMBROA_WBB.xml",
        "03b_registrationRequest_SLD_ChangeSoilLocation_IMBROA_WBB.xml",
        "03c_registrationRequest_SLD_NewDecision_IMBROA_WBB_2.xml"
      ],
      "mutations": [
        {
          "xpath": "//imsikb0101:metaData/imsikb0101:dataflow",
          "action": "remove"
        }
      ],
      "expect": [
        {
          "type": "WARNING",
          "title_contains": "dataflow",
          "message_contains": "Er zou een metadata/dataflow ingevuld moeten zijn"
        },
        {
          "type": "WARNING",
          "title_contains": "dataflow",
          "message_contains": "zou ingevuld moeten zijn met"
        }
      ]
    },
    {
